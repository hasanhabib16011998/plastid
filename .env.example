# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=payload
POSTGRES_PASSWORD=afvaerhgbqerl
POSTGRES_DB=plastid_cms

# ── Payload CMS ─────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
PAYLOAD_SECRET=wiyfgilfhbvqleiryfgvbilqwer
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4000

# ── MinIO / S3 ──────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=plastid-media
S3_REGION=us-east-1
S3_ACCESS_KEY=dlfihvbaegh
S3_SECRET_KEY=idfgblefvbweiyrgberh
# Note: S3_ENDPOINT inside docker is http://minio:9000
# For local dev outside docker use: http://localhost:9000

# ── Frontend Origins (CORS & CSRF) ──────────────────────────────────
# Replace with your actual production domains later.
# For local dev, use the dev server port of each frontend.
PLASTID_INTERIOR_URL=http://localhost:3000
SUN_REAL_ESTATE_URL=http://localhost:5174
PLASTID_DIGITAL_URL=http://localhost:5175
PLASTID_CONSTRUCTION_URL=http://localhost:5176

# ── Seed Script ─────────────────────────────────────────────────────
